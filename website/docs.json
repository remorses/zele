{
  "$schema": "https://holocron.so/docs.json",
  "name": "zele",
  "description": "Email and calendar CLI for Gmail, Outlook, IMAP/SMTP, and Google Calendar. For you and your agents.",
  "colors": {
    "primary": "#0ea5e9",
    "light": "#0ea5e9",
    "dark": "#7dd3fc"
  },
  "knownPaths": ["/api/*"],
  "decorativeLines": "none",
  "layout": {
    "mode": "compact"
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting Started",
        "icon": "lucide:rocket",
        "pages": ["index"]
      },
      {
        "group": "Legal",
        "hidden": true,
        "pages": ["privacy", "terms"]
      }
    ],
    "global": {
      "anchors": [
        { "anchor": "GitHub", "icon": "lucide:github", "href": "https://github.com/remorses/zele" },
        { "anchor": "Changelog", "icon": "lucide:newspaper", "href": "https://github.com/remorses/zele/releases" }
      ]
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/remorses/zele"
    },
    "links": [
      {
        "header": "Legal",
        "items": [
          { "label": "Privacy policy", "href": "/privacy" },
          { "label": "Terms of service", "href": "/terms" }
        ]
      }
    ]
  }
}
